NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Legal identity shown in the footer and policy pages. Operator defaults to Strata when unset.
NEXT_PUBLIC_OPERATOR_NAME=Strata
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_JURISDICTION=
NEXT_PUBLIC_BUSINESS_ADDRESS=

# Set to false on production so demo personas stay hidden. Preview and local can leave this true.
NEXT_PUBLIC_ENABLE_DEMO_PROFILES=true

# Launch 1.1: add a custom domain and branded SMTP, then turn off the auto-confirm email trigger.

